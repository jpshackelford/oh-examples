{
  "id": "dadjokes.groan",
  "name": "Dad Jokes",
  "version": "1.0.0",
  "publisher": "dadjokes",
  "description": "Because every coding session needs more groaning. 🙄",
  "engines": { "agentCanvas": "^1.0.0" },
  "main": "main.js",
  "activationEvents": ["onView:dadjokes.panel", "onCommand:dadjokes.random", "onCommand:dadjokes.encourage"],
  "capabilities": ["conversation:read", "storage"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "dadjokes.container", "title": "Dad Jokes", "icon": "icon.svg" }
      ]
    },
    "views": {
      "dadjokes.container": [
        {
          "id": "dadjokes.panel",
          "name": "Dad Jokes",
          "type": "webview",
          "page": "panel.html"
        }
      ]
    },
    "commands": [
      { "command": "dadjokes.random", "title": "🤣 Tell me a Dad Joke" },
      { "command": "dadjokes.encourage", "title": "👴 Words of Wisdom" }
    ],
    "menus": {
      "conversationTabs/context": [{ "command": "dadjokes.random" }],
      "chatInput/actions": [{ "command": "dadjokes.encourage" }]
    },
    "settingsPages": [
      { "id": "preferences", "title": "Dad Jokes", "page": "settings.html" }
    ]
  }
}
